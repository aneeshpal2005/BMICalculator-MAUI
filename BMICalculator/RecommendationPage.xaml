<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BMICalculator.RecommendationPage"
             BackgroundColor="White"
             Title="">
    <VerticalStackLayout Padding="20" Spacing="20">
        
        <Label x:Name="recommendationLabel"
               FontSize="18"
               Padding="20"
               TextColor="Black"
               HorizontalOptions="Center"
               />

        <Button Text="Back to BMI Results"
                BackgroundColor="MediumPurple"
                TextColor="White"
                BorderColor="Bisque"
                BorderWidth="2"
                Clicked="BackToResultPage_Clicked"/>

        <Button Text="Back to Input Page"
                BackgroundColor="MediumPurple"
                TextColor="White"
                BorderColor="Bisque"
                BorderWidth="2"
                Clicked="BackToMainPage_Clicked"/>
        
    </VerticalStackLayout>
</ContentPage>